---
import type { GearItem } from '../data/gear';

type Props = GearItem;

const { name, spec, post, url } = Astro.props;
---

<article class="gear">
	<div class="body">
		<h2>{name}</h2>
		{spec && <p class="spec">{spec}</p>}
	</div>

	{
		(post || url) && (
			<p class="links">
				{post && <a href={post.href}>{post.label}</a>}
				{url && (
					<a href={url} target="_blank" rel="noopener">
						販売ページ
					</a>
				)}
			</p>
		)
	}
</article>

<style>
	.gear {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.1rem 0;
		border-top: 1px solid rgba(var(--gray-light), 1);
	}

	.body {
		flex: 1;
		min-width: 0;
	}
	.body h2 {
		margin: 0 0 0.2rem;
		padding: 0;
		border: none;
		font-size: 1em;
		line-height: 1.5;
	}
	.spec {
		margin: 0;
		font-size: 0.8em;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	.links {
		margin: 0;
		font-size: 0.78em;
		white-space: nowrap;
	}
	.links a + a {
		margin-left: 1.2rem;
	}

	@media (max-width: 600px) {
		.gear {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
