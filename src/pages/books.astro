---
import BaseHead from '../components/BaseHead.astro';
import Book from '../components/Book.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { amazonSearchUrl, books } from '../data/books';

const title = '読んだ本';
const description = '読んだ本の記録。';
const total = books.reduce((n, g) => n + g.items.length, 0);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>読んだ本</h1>
			{
				total === 0 ? (
					<p class="empty">まだ登録がありません。</p>
				) : (
					books.map((group) => (
						<section class="group">
							<h2>{group.category}</h2>
							{group.layout === 'compact' ? (
								<ul class="compact">
									{group.items.map((item) => (
										<li>
											<a
												class="c-title"
												href={item.url ?? amazonSearchUrl(item)}
												target="_blank"
												rel="noopener"
											>
												{item.title}
											</a>
											{item.author && <span class="c-author">{item.author}</span>}
										</li>
									))}
								</ul>
							) : (
								group.items.map((item) => <Book {...item} />)
							)}
						</section>
					))
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--list-width);
	}
	h1 {
		margin-bottom: 2rem;
	}
	.group {
		margin-bottom: 2.5rem;
	}
	.group h2 {
		margin-bottom: 0;
	}
	.empty {
		padding: 3rem 0;
		color: rgb(var(--gray));
		text-align: center;
	}

	/* コンパクト表示 */
	.compact {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		column-gap: 2.5rem;
	}
	@media (min-width: 720px) {
		.compact {
			grid-template-columns: 1fr 1fr;
		}
	}
	.compact li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0;
		padding: 0.85rem 0;
		border-bottom: 1px solid rgba(var(--gray-light), 1);
	}
	.c-title {
		font-size: 0.85em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.c-title:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.c-author {
		font-size: 0.75em;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
</style>
