---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { gear } from '../data/gear';

const title = '使っているもの';
const description = '自宅サーバーやデスク周りで実際に使っている機材。';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>使っているもの</h1>
			<ul class="compact">
				{
					gear.map((item) => (
						<li>
							{item.url ? (
								<a class="c-title" href={item.url} target="_blank" rel="noopener">
									{item.name}
								</a>
							) : (
								<span class="c-title">{item.name}</span>
							)}
							{item.spec && <span class="c-spec">{item.spec}</span>}
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--list-width);
	}
	h1 {
		margin-bottom: 2rem;
	}

	/* 本棚と同じコンパクト表示。スペックは名前の下に置く */
	.compact {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		column-gap: 2.5rem;
	}
	@media (min-width: 720px) {
		.compact {
			grid-template-columns: 1fr 1fr;
		}
	}
	.compact li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
		padding: 0.85rem 0;
		border-bottom: 1px solid rgba(var(--gray-light), 1);
	}
	.c-title {
		font-size: 0.85em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	a.c-title:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.c-spec {
		font-size: 0.72em;
		line-height: 1.6;
		color: rgb(var(--gray));
	}
</style>
