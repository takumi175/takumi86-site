---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const timeline = [
	{
		period: '大学に入るまで',
		items: [
			'<strong>中学</strong> — Scratch を触る。タイピングを練習する',
			'<strong>高校</strong> — Unity を触る',
		],
	},
	{
		period: '大学1年',
		items: [
			'<strong>前期</strong> — 情報系サークルに入り、新入生ハッカソンでブックマーク管理Webアプリを作る',
			'<strong>夏休み</strong> — 合宿のハッカソンで中国語単語Webアプリを作る',
			'<strong>後期</strong> — 大学のハッカソンで、チームでタスク管理Webアプリを開発',
			'<strong>春休み</strong> — バイトを始める。Raspberry Pi を購入。Claude Pro を契約。技育祭にオンライン参加。基本情報技術者試験に合格',
		],
	},
	{
		period: '大学2年',
		items: [
			'<strong>前期</strong> — LaTeX で実験レポートを書く',
			'<strong>夏休み</strong> — TOEIC 初受験、引っ越し、自宅サーバーの構築、アプリ開発、デスク環境の整備',
		],
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Takumi</h1>
				<p class="eyebrow">情報工学部 / 学部2年</p>
				<p class="lead">
					AIを使ってWebアプリを作ったり、自宅サーバーを立てたりしています。
					作ったものの記録は<a href="/blog">ブログ</a>に書いています。ほかに<a href="/gear">使っているもの</a>・<a href="/books">読んだ本</a>・<a href="/anime">見たアニメ</a>のページもあります。
					このサイトは記事も含め、AIを使って作っています。
				</p>
			</section>

			<section>
				<h2>これまで</h2>
				{
					timeline.map((group) => (
						<div class="tl-group">
							<h3 class="tl-period">{group.period}</h3>
							<ul class="tl">
								{group.items.map((item) => (
									<li set:html={item} />
								))}
							</ul>
						</div>
					))
				}
			</section>

			<section>
				<h2>資格・試験</h2>
				<ul class="plain">
					<li>基本情報技術者試験 合格</li>
					<li>TOEIC 555点（1回目）</li>
				</ul>
			</section>

			<section>
				<h2>連絡先</h2>
				<div class="links">
					<a class="link" href="https://github.com/takumi175">
						<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"
							><path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							/></svg
						>
						<span>GitHub <span class="handle">@takumi175</span></span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--list-width);
	}

	/* 冒頭のプロフィール */
	.intro {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(var(--gray-light), 1);
	}
	.eyebrow {
		margin: 0 0 0.8rem;
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
	}
	.intro h1 {
		margin: 0 0 0.3rem;
	}
	.lead {
		margin: 0;
		max-width: 32em;
	}
	.lead a {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	/* 年表 */
	.tl-group {
		margin-bottom: 1.8rem;
	}
	.tl-period {
		font-size: 0.95em;
		color: rgb(var(--gray));
		margin: 0 0 0.7rem 0;
	}
	.tl {
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.4rem;
		border-left: 2px solid rgba(var(--gray-light), 1);
	}
	.tl li {
		position: relative;
		margin-bottom: 0.9rem;
		font-size: 0.92em;
	}
	.tl li::before {
		content: '';
		position: absolute;
		left: calc(-1.4rem - 5px);
		top: 0.62em;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
	}
	.tl li:last-child {
		margin-bottom: 0;
	}

	.plain {
		font-size: 0.92em;
	}

	/* 連絡先 */
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid rgba(var(--gray-light), 1);
		border-radius: 999px;
		background: #fff;
		text-decoration: none;
		color: rgb(var(--black));
		font-size: 0.9em;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.handle {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.link:hover .handle {
		color: var(--accent);
	}

</style>
