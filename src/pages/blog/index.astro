---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>記事一覧</h1>
			<p class="lead">{posts.length} 件の記事があります。</p>

			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										class="thumb"
										width={640}
										height={320}
										src={post.data.heroImage}
										alt=""
									/>
								)}
								<div class="body">
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="title">{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
									{post.data.tags && post.data.tags.length > 0 && (
										<p class="tags">
											{post.data.tags.map((t: string) => (
												<span class="tag">{t}</span>
											))}
										</p>
									)}
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 900px;
	}
	h1 {
		margin-bottom: 0.3rem;
	}
	.lead {
		margin-bottom: 3rem;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}
	.posts li {
		margin: 0;
		border-top: 1px solid rgba(var(--gray-light), 1);
	}
	.posts li:last-child {
		border-bottom: 1px solid rgba(var(--gray-light), 1);
	}
	.posts a {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 1.6rem;
		align-items: start;
		padding: 1.8rem 0;
		text-decoration: none;
		color: inherit;
	}
	.thumb {
		width: 100%;
		height: auto;
		border-radius: 8px;
		border: 1px solid rgba(var(--gray-light), 1);
		transition: border-color 0.2s ease;
	}
	.posts a:hover .thumb {
		border-color: var(--accent);
	}
	.date {
		margin: 0 0 0.4rem;
		font-size: 0.72em;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
	}
	.title {
		margin: 0 0 0.6rem;
		padding: 0;
		border: none;
		font-size: 1.15em;
		line-height: 1.55;
		color: rgb(var(--black));
		transition: color 0.2s ease;
	}
	.posts a:hover .title {
		color: var(--accent);
	}
	.desc {
		margin: 0;
		font-size: 0.82em;
		line-height: 1.8;
		color: rgb(var(--gray));
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.8rem 0 0;
	}
	.tag {
		font-size: 0.68em;
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--accent);
		background: #eef0ff;
		padding: 0.25em 0.7em;
		border-radius: 999px;
	}

	@media (max-width: 720px) {
		.posts a {
			grid-template-columns: 1fr;
			gap: 0.9rem;
		}
	}
</style>
