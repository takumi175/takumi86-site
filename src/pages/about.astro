---
import AboutHeroImage from '../assets/blog/hero-about.svg';
import Layout from '../layouts/BlogPost.astro';

const works = [
	{
		href: '/blog/01-homeserver-overview/',
		title: '自宅サーバー',
		desc: 'ミニPCに Proxmox を入れて、DNS・監視・アプリのホスティングまで',
		tags: ['Proxmox', 'Docker', 'Tailscale'],
	},
	{
		href: '/blog/06-chinese-learning-app/',
		title: '中国語単語アプリ',
		desc: '400語を12通りの出し方で解く学習アプリ。個人開発',
		tags: ['React', 'Flask', 'PostgreSQL'],
	},
	{
		href: '/blog/07-task-management-hackathon/',
		title: 'タスク管理アプリ',
		desc: 'タスクを終わらせるとキャラが育つ。6人チームで開発',
		tags: ['Vue', 'FastAPI', 'Gemini'],
	},
];

const timeline = [
	{
		period: '大学に入るまで',
		items: ['中学 — Scratch を触る。タイピングを練習する', '高校 — Unity を触る'],
	},
	{
		period: '大学1年',
		items: [
			'<strong>前期</strong> — 情報系サークルに入り、新入生ハッカソンで Web 開発の基礎を学ぶ',
			'<strong>夏休み</strong> — 合宿のハッカソンで、AI を使いながら<a href="/blog/06-chinese-learning-app/">中国語単語アプリ</a>を作る',
			'<strong>後期</strong> — 大学のハッカソンで、チームで<a href="/blog/07-task-management-hackathon/">タスク管理アプリ</a>を開発',
			'<strong>春休み</strong> — バイトを始める。Raspberry Pi を購入。Claude を使い始める。技育祭にオンライン参加。基本情報技術者試験に合格',
		],
	},
	{
		period: '大学2年',
		items: [
			'<strong>前期</strong> — 実験レポートを LaTeX で書くようになる',
			'<strong>夏休み</strong> — TOEIC 受験、引っ越し、<a href="/blog/01-homeserver-overview/">自宅サーバーの構築</a>、アプリ開発、デスク環境の整備',
		],
	},
];
---

<Layout
	title="About"
	description="Takumi について — つくったものと、そこで詰まったことの記録"
	pubDate={new Date('2026-09-09')}
	heroImage={AboutHeroImage}
>
	<p class="lead">
		情報工学部の学生です。Webアプリを作ったり、自宅サーバーを立てて遊んだりしています。
		このブログには、手を動かして分かったことと、詰まったところを残しています。
	</p>

	<h2>つくったもの</h2>
	<div class="cards">
		{
			works.map((w) => (
				<a class="card" href={w.href}>
					<span class="card-title">{w.title}</span>
					<span class="card-desc">{w.desc}</span>
					<span class="card-tags">
						{w.tags.map((t) => (
							<span class="chip">{t}</span>
						))}
					</span>
				</a>
			))
		}
	</div>

	<h2>これまで</h2>
	{
		timeline.map((group) => (
			<section class="tl-group">
				<h3 class="tl-period">{group.period}</h3>
				<ul class="tl">
					{group.items.map((item) => (
						<li set:html={item} />
					))}
				</ul>
			</section>
		))
	}

	<h2>いま取り組んでいること</h2>
	<ul class="plain">
		<li>中国語学習アプリの開発</li>
		<li>自由科目のアプリ開発</li>
		<li>自宅サーバーの運用と、その記録をブログに書くこと</li>
	</ul>

	<h2>資格・試験</h2>
	<ul class="plain">
		<li>基本情報技術者試験 合格</li>
	</ul>

	<h2>連絡先</h2>
	<div class="links">
		<a class="link" href="https://github.com/takumi175">
			<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				/></svg
			>
			<span>GitHub <span class="handle">@takumi175</span></span>
		</a>
		<a class="link" href="https://x.com/takumi3743">
			<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"
				><path
					fill="currentColor"
					d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
				/></svg
			>
			<span>X <span class="handle">@takumi3743</span></span>
		</a>
	</div>
</Layout>

<style>
	.lead {
		font-size: 1.08em;
		line-height: 1.8;
		margin-bottom: 2.5rem;
	}

	/* つくったもの */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid rgba(var(--gray-light), 1);
		border-radius: 12px;
		background: #fff;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
	}
	.card-title {
		font-weight: 700;
		color: rgb(var(--black));
	}
	.card-desc {
		font-size: 0.85em;
		line-height: 1.6;
		color: rgb(var(--gray));
	}
	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.2rem;
	}
	.chip {
		font-size: 0.72em;
		font-weight: 700;
		color: var(--accent);
		background: #eef0ff;
		padding: 0.25em 0.7em;
		border-radius: 999px;
	}

	/* 年表 */
	.tl-group {
		margin-bottom: 1.8rem;
	}
	.tl-period {
		font-size: 1em;
		color: rgb(var(--gray));
		margin: 0 0 0.7rem 0;
	}
	.tl {
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.4rem;
		border-left: 2px solid rgba(var(--gray-light), 1);
	}
	.tl li {
		position: relative;
		margin-bottom: 0.9rem;
		line-height: 1.75;
	}
	.tl li::before {
		content: '';
		position: absolute;
		left: calc(-1.4rem - 5px);
		top: 0.62em;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
	}
	.tl li:last-child {
		margin-bottom: 0;
	}

	.plain {
		line-height: 1.9;
	}

	/* 連絡先 */
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid rgba(var(--gray-light), 1);
		border-radius: 999px;
		background: #fff;
		text-decoration: none;
		color: rgb(var(--black));
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.handle {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.link:hover .handle {
		color: var(--accent);
	}

	@media (max-width: 600px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
